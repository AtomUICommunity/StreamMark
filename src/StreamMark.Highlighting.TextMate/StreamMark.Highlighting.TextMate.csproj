<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- 目标框架由 Directory.Build.props 统一为 net10.0；这三个库额外支持 net8.0（TKCode.Arc 的 .NET 8 宿主） -->
        <TargetFramework />
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <Description>TextMate-based incremental syntax highlighting for StreamMark code blocks.</Description>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="TextMateSharp" />
        <PackageReference Include="TextMateSharp.Grammars" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\StreamMark.Core\StreamMark.Core.csproj" />
        <ProjectReference Include="..\StreamMark.Avalonia\StreamMark.Avalonia.csproj" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="StreamMark.Avalonia.Tests" />
    </ItemGroup>
</Project>
