<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- 目标框架由 Directory.Build.props 统一为 net10.0；这三个库额外支持 net8.0（TKCode.Arc 的 .NET 8 宿主） -->
        <TargetFramework />
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <Description>StreamMark Avalonia controls: self-drawn Markdown blocks, virtualizing transcript panel and selection.</Description>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\StreamMark.Core\StreamMark.Core.csproj" />
    </ItemGroup>
</Project>
